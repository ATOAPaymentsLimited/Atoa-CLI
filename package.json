{
  "name": "@atoapayments/atoa-cli",
  "version": "0.2.14",
  "description": "First-party CLI for the Atoa payment API.",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "bin": {
    "atoa": "./bin/atoa.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "pkg": {
    "scripts": "dist/**/*.js"
  },
  "scripts": {
    "build": "npm run gen:logo && tsup",
    "build:release": "npm run gen:logo && tsup",
    "clean": "rimraf dist",
    "dev": "tsx src/cli.ts",
    "dev:local": "cross-env ATOA_ALLOW_INSECURE=1 ATOA_BASE_URL=http://localhost:9090/server ATOA_DASHBOARD_URL=http://localhost:3000 tsx src/cli.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"test/**/*.ts\"",
    "prettier": "prettier \"src/**/*.ts\" \"test/**/*.ts\" --write",
    "prettier:check": "prettier \"src/**/*.ts\" \"test/**/*.ts\" --check",
    "prepublishOnly": "npm run lint && npm run test:unit && npm run build",
    "test": "vitest run --coverage",
    "test:unit": "vitest run test/lib test/commands",
    "test:e2e": "cross-env ATOA_CLI_E2E=1 vitest run test/integration",
    "gen:logo": "node scripts/gen-logo.mjs && prettier --write src/lib/atoa-logo.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "citty": "^0.2.2",
    "cli-table3": "^0.6.5",
    "js-yaml": "^4.1.0",
    "undici": "^6.19.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.6",
    "cross-env": "^7.0.3",
    "msw": "^2.3.0",
    "prettier": "^3.4.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ATOAPaymentsLimited/Atoa-CLI"
  },
  "bugs": {
    "url": "https://github.com/ATOAPaymentsLimited/Atoa-CLI/issues",
    "email": "vamsi@paywithatoa.co.uk"
  },
  "homepage": "https://github.com/ATOAPaymentsLimited/Atoa-CLI#readme",
  "keywords": [
    "atoa",
    "atoa pay",
    "cli",
    "agentic payments"
  ]
}